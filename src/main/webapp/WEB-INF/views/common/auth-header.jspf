<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}"/> | SpendWise</title>
  <link rel="stylesheet" href="${ctx}/css/style.css">
  <script defer src="${ctx}/js/app.js"></script>
</head>
<body class="auth-body">
<main class="auth-card">
  <div class="brand brand-auth">SpendWise</div>
  <p class="auth-tagline">Subscriptions, expenses and monthly budget in one place.</p>
  <c:if test="${not empty flashSuccess}"><div class="alert alert-success" role="status"><c:out value="${flashSuccess}"/></div></c:if>
  <c:if test="${not empty flashError}"><div class="alert alert-error" role="alert"><c:out value="${flashError}"/></div></c:if>
